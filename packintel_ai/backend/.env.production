# Production environment
APP_ENV=production
APP_VERSION=1.0.0
DEBUG=false

# Database (use PostgreSQL in production)
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/packintel_prod

# CORS (restrict to your domain)
ALLOWED_ORIGINS=https://packintel.example.com,https://www.packintel.example.com

# Production mode (not demo)
DEMO_MODE=false

# Qdrant
QDRANT_HOST=qdrant-host
QDRANT_PORT=6333
QDRANT_API_KEY=your-secure-api-key

# LLM (optional OpenAI for enhanced explanations)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# File upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/var/packintel/uploads
