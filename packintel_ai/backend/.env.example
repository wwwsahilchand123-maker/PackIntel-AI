# Application
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./packintel.db

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo Mode (set to true to run without Qdrant/LLM)
DEMO_MODE=true

# Qdrant (required when DEMO_MODE=false)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# LLM (optional - only for explanation generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedder
EMBEDDER_MODEL=all-MiniLM-L6-v2

# File Upload
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads
